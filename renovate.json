{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":semanticCommitsDisabled"],
  "schedule": ["before 6am on monday"],
  "timezone": "Asia/Singapore",
  "prConcurrentLimit": 4,
  "lockFileMaintenance": { "enabled": true, "schedule": ["before 6am on the first day of the month"] },
  "packageRules": [
    {
      "description": "tree-sitter core and grammars move together",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["/^tree-sitter/"],
      "groupName": "tree-sitter"
    },
    {
      "description": "GitHub Actions stay SHA-pinned; group their updates",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "Merge non-major dev and tooling updates when CI is green",
      "matchUpdateTypes": ["minor", "patch"],
      "matchDepTypes": ["dev-dependencies", "dev"],
      "automerge": true
    }
  ]
}
