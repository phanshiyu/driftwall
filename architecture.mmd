%% driftwall architecture contract.
%% Solid arrow  (-->)  = implemented dependency, enforced.
%% Dotted arrow (-.->) = planned dependency, tolerated until built.
flowchart LR

  subgraph engine["Engine"]
    init["init: baseline generator"]
    lint["lint: reconcile code graph vs diagram"]
  end

  subgraph entry["Entry"]
    cli["cli: args, exit codes"]
  end

  subgraph shared["Shared"]
    model["model: ids, edges, violations"]
    report["report: text, json, sarif"]
  end

  subgraph sources["Sources"]
    subgraph reading["Reading code"]
      subgraph languages["Languages"]
        ecmascript["ecmascript: TS, JS, Svelte, HTML; tsconfig, vite, workspaces"]
        python["python: imports, roots, stdlib"]
        rust["rust: use paths, modules, Cargo"]
        shell["shell: source and script references"]
        swift["swift: imports, SwiftPM targets"]
      end
      imports["imports: collect a repo's imports, one language at a time"]
      syntax["syntax: tree-sitter specs, statements, shared resolution"]
    end
    diagram["diagram: parse + render contract"]
    markup["markup: HTML and Svelte script scanner"]
    ownership["ownership: walk, maps, ignores"]
  end

  cli --> init
  cli --> lint
  cli --> model
  cli --> ownership
  cli --> report
  diagram --> model
  ecmascript --> markup
  imports --> model
  imports --> syntax
  init --> diagram
  init --> imports
  init --> model
  init --> ownership
  lint --> diagram
  lint --> imports
  lint --> model
  lint --> ownership
  ownership --> markup
  ownership --> model
  report --> model
  syntax --> model
  imports --> languages
  languages -->|test| imports
  languages --> model
  languages --> syntax

